{
  "rewrites": [
    { "source": "/auth/google", "destination": "/api/auth/google" },
    { "source": "/auth/google/callback", "destination": "/api/auth/callback" },
    { "source": "/auth/logout", "destination": "/api/auth/logout" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
